# Cloudflare Pages `_redirects` is path-only.
# Domain-level (host) redirects are unsupported — see
# https://developers.cloudflare.com/pages/configuration/redirects/
# Do NOT add `/* https://www.rutinhq.com/:splat 301`: that would also
# 301 www onto itself (no hostname match). Apex → www is a zone
# Single Redirect / Bulk Redirect (Capo / Dashboard). Steps in README.
#
# Crawl files ship from public/ into dist/. These lines stay above the
# SPA fallback so /sitemap.xml and /robots.txt are never rewritten to HTML.
/sitemap.xml /sitemap.xml 200
/robots.txt /robots.txt 200
/services / 301
/case-studies / 301
/blog/why-one-sku /blog 301
# Blog crawl shells. Do NOT rewrite /blog → /blog.html (or emit dist/blog.html):
# Pages html-handling 308s *.html to the pretty URL, so that pair self-loops
# Location: /blog. Same class of bug as exact /{sku} /index.html 200.
# Target the extensionless pretty URL under /prerender/ (that path 200s).
# Article01 used to 308 → /prerender/<slug>.html pretty URL; point at it directly.
/blog /prerender/blog 200
/blog/ /prerender/blog 200
/blog/icp-gated-cold-outbound-without-rented-sdr /prerender/blog-icp-gated-cold-outbound-without-rented-sdr 200
/blog/icp-gated-cold-outbound-without-rented-sdr/ /prerender/blog-icp-gated-cold-outbound-without-rented-sdr 200
/es /es/blog 301
/es/blog /prerender/es-blog 200
/es/blog/ /prerender/es-blog 200
/es/blog/outbound-frio-con-icp-sin-sdr-rentado /prerender/es-blog-outbound-frio-con-icp-sin-sdr-rentado 200
/es/blog/outbound-frio-con-icp-sin-sdr-rentado/ /prerender/es-blog-outbound-frio-con-icp-sin-sdr-rentado 200
/*      /index.html  200
