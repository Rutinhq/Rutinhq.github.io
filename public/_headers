# Published /blog + Article01 are crawlable (sitemap + prerendered HTML).
# Do not send X-Robots-Tag: noindex on those paths.

# HTML + prerender shells: short cache so copy/SEO updates land.
# RFC 8288 Link (Agent Readiness Soft P1). Cloudflare Pages splat `/*`
# matches every request URL, including SPA pretty routes rewritten to
# index.html / prerender shells. Link is safe on static assets; do not
# add Content-Type here. Content-Type rules below stay path-specific.
# Do not enable CF Markdown Negotiation or Zero Trust bypass from this file.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Link: </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"; type="text/plain"

# Vite hashed bundles (/assets/*.js).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted latin subsets (stable filenames; bump the file to invalidate).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Content-Type: image/x-icon

# GEO/LLM discovery files. Must stay text/plain — never the SPA HTML shell.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
