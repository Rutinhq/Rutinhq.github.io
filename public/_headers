# Blog pretty URLs stay off the sitemap and emit page robots
# `noindex, follow` until publish GO. Do not send X-Robots-Tag: noindex
# on those paths — crawlers must read the HTML meta (follow links).

# Shared headers for every request URL. Do NOT set Cache-Control on `/*`:
# Pages inherits every matching rule and comma-joins the same header
# (live smoke 14 Sep after #40: discovery emitted
# max-age=0 + max-age=3600). Link is safe on static assets; do not add
# Content-Type here. Content-Type rules below stay path-specific.
# Content-Signal complements robots.txt (LIVE). Capo lock is ai-train=no;
# an origin HTTP header stops CF Markdown converter from injecting
# ai-train=yes. Pages applies every indented name:value under the same
# path block as separate headers (not a comma-join unless the same name
# is repeated). Do not enable CF Markdown Negotiation or Zero Trust
# bypass from this file.
/*
  Link: </sitemap.xml>; rel="sitemap", </llms.txt>; rel="describedby"; type="text/plain", </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </auth.md>; rel="describedby"; type="text/markdown"
  Content-Signal: search=yes, ai-train=no, use=reference
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML SPA request paths (pretty URLs + shells). Short cache so copy/SEO
# updates land. New pretty HTML routes need a rule here or a safe prefix
# splat. Do not use /agents* — that prefix also matches /agents.md.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/gtm-os
  Cache-Control: public, max-age=0, must-revalidate

/gtm-os/
  Cache-Control: public, max-age=0, must-revalidate

/store-os
  Cache-Control: public, max-age=0, must-revalidate

/store-os/
  Cache-Control: public, max-age=0, must-revalidate

/nexus-os
  Cache-Control: public, max-age=0, must-revalidate

/nexus-os/
  Cache-Control: public, max-age=0, must-revalidate

/blog
  Cache-Control: public, max-age=0, must-revalidate

/blog/
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

/agents
  Cache-Control: public, max-age=0, must-revalidate

/agents/
  Cache-Control: public, max-age=0, must-revalidate

/agents/*
  Cache-Control: public, max-age=0, must-revalidate

/es
  Cache-Control: public, max-age=0, must-revalidate

/es/
  Cache-Control: public, max-age=0, must-revalidate

/es/*
  Cache-Control: public, max-age=0, must-revalidate

# Internal crawl shells. Pretty URLs (/gtm-os) are request-path matched by
# the HTML rules above — this block only hits a direct /prerender/… request.
# Do NOT 301 /prerender/:slug → /:slug (that pair loops with the 200 rewrite).
/prerender/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

/guide-kb.json
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: noindex, nofollow

# Vite hashed bundles (/assets/*.js).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted latin subsets (stable filenames; bump the file to invalidate).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Content-Type: image/x-icon

/favicon.svg
  Content-Type: image/svg+xml

/favicon-48x48.png
  Content-Type: image/png

/favicon-192x192.png
  Content-Type: image/png

/apple-touch-icon.png
  Content-Type: image/png

/site.webmanifest
  Content-Type: application/manifest+json

# GEO/LLM discovery files. Must stay text/plain — never the SPA HTML shell.
# Sole Cache-Control for these files (`/*` no longer sets one). Free Pages
# can edge-cache them (HIT/REVALIDATED or at least max-age>0). Do not use
# immutable — copy can change. No Cache Rules / paid CF.
# Content-Signal + Link stay on the /* merge; do not repeat them here.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# RFC 9727 catalog + WorkOS-style auth.md. Keep non-HTML so Pages
# never serves the SPA shell. Free CF Pages headers only — no Pro
# vanity host, pay-per-crawl, or x402 from this file.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/agents.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Generated at build (dist/sitemap.xml). Same public cache as the other
# agent-discovery files. HTML routes stay on the HTML path rules above.
/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
