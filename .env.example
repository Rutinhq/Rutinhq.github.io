# No backend required. Public CTA: https://calendly.com/rutinhq/30min
# Secondary email: mailto:strategy@rutinhq.com
#
# RutinHQ Guide (optional live LLM — omit to degrade to catalog + Calendly)
# Default on Pages: Workers AI via wrangler.toml [ai] binding = "AI"
# GUIDE_LLM_PROVIDER=workers-ai
# GUIDE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# Optional Gemini/OpenAI-compat (needs billing on Gemini; GUIDE_LLM_API_KEY secret):
# GUIDE_LLM_PROVIDER=openai-compat
# GUIDE_LLM_API_KEY=
# GUIDE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GUIDE_LLM_MODEL=gemini-3.1-flash-lite
# Alternative: OpenAI
# GUIDE_LLM_BASE_URL=https://api.openai.com/v1
# GUIDE_LLM_MODEL=gpt-4o-mini
# Optional lead webhook (Capo sets the Pages secret). Leave unset locally — no fake URL.
# GUIDE_LEAD_WEBHOOK_URL=
# GUIDE_KB_SKIP_CRAWL=1
#
# Turnstile (optional locally — fail-open in dev when the secret is unset)
# Production/preview `vite build` reads `.env.production` (public site key).
# TURNSTILE_SECRET_KEY=
